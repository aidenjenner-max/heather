<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Invite links like https://heather-delta.vercel.app/?join=CODE open straight into the app. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:heather-delta.vercel.app</string>
	</array>
</dict>
</plist>
